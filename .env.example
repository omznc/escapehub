# EscapeHub configuration. Copy this file to .env. The .env file is the only source of configuration values.
# docker compose reads it for all containers. The host names are the names of the Docker services.
# To run the API or the worker outside Docker, set these variables in the shell. The shell values override this file:
#   SQLSERVER_HOST=localhost SQLSERVER_PORT=14330 RABBITMQ_HOST=localhost SMTP_HOST=localhost

# Application
APP_TIME_ZONE=Europe/Sarajevo

# SQL Server
# SQLSERVER_PORT is the port inside the Docker network. SQLSERVER_HOST_PORT is the port on the host computer.
SQLSERVER_HOST=sqlserver
SQLSERVER_PORT=1433
SQLSERVER_HOST_PORT=14330
SQLSERVER_DATABASE=200228
SQLSERVER_USER=sa
SQLSERVER_SA_PASSWORD=CHANGE_ME

# JWT
JWT_SECRET=CHANGE_ME
JWT_ISSUER=EscapeHub
JWT_AUDIENCE=EscapeHub
JWT_EXPIRY_MINUTES=120

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASS=CHANGE_ME
RABBITMQ_VHOST=/

# SMTP (Mailpit in development)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=noreply@escapehub.ba
SMTP_FROM_NAME=EscapeHub
MAILPIT_UI_PORT=8025

# API
API_PORT=5000
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://localhost:3000,http://localhost:8080,http://localhost:8081,http://localhost:8082
SWAGGER_ENABLED=true
FILE_STORAGE_PATH=./storage
PASSWORD_RESET_CODE_MINUTES=15
AUTH_RATE_LIMIT_PERMITS=30
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Worker
REMINDER_SCAN_INTERVAL_SECONDS=60
POINTS_SWEEP_INTERVAL_SECONDS=300
